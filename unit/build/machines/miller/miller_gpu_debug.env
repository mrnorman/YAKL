#!/bin/bash

source ${MODULESHOME}/init/bash
module reset
module load PrgEnv-gnu cuda/12.6 craype-accel-nvidia80 cray-hdf5 cray-netcdf cray-parallel-netcdf

export CC=cc
export FC=ftn
export CXX=CC

unset CXXFLAGS
unset FFLAGS
unset F77FLAGS
unset F90FLAGS

export YAKL_DEBUG=OFF
export YAKL_CXX_FLAGS="-O0;-g"
export YAKL_LINK_FLAGS=""
export YAKL_F90_FLAGS="-O0"
export YAKL_BACKEND=Kokkos_ENABLE_CUDA
export YAKL_ARCH=Kokkos_ARCH_AMPERE80
export YAKL_TEST_NETCDF=ON
export YAKL_TEST_PNETCDF=ON
export YAKL_HAVE_MPI=OFF
export YAKL_MPI_COMMAND=""
