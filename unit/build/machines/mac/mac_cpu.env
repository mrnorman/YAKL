#!/bin/bash

export CC=gcc-15
export CXX=g++-15
export FC=gfortran-15

unset CXXFLAGS
unset CFLAGS
unset FFLAGS

export YAKL_DEBUG=OFF
export YAKL_CXX_FLAGS="-O3;-Wno-unused-result;-Wno-macro-redefined"
export YAKL_LINK_FLAGS=""
export YAKL_F90_FLAGS="-O3"
export YAKL_BACKEND=""
export YAKL_ARCH=""
export YAKL_TEST_NETCDF=OFF
export YAKL_TEST_PNETCDF=OFF
export YAKL_HAVE_MPI=OFF
export YAKL_MPI_COMMAND=""
