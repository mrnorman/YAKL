#!/bin/bash

source ${MODULESHOME}/init/bash
module reset
module load PrgEnv-amd cray-parallel-netcdf cmake cray-hdf5 cray-netcdf

export CRAYPE_LINK_TYPE=dynamic
export CC=cc
export CXX=CC
export FC=ftn

unset CXXFLAGS
unset CFLAGS
unset FFLAGS

export YAKL_DEBUG=OFF
export YAKL_CXX_FLAGS="-O3;-Wno-unused-result;-Wno-macro-redefined"
export YAKL_LINK_FLAGS=""
export YAKL_F90_FLAGS="-O3"
export YAKL_BACKEND=""
export YAKL_ARCH=""
export YAKL_TEST_NETCDF=ON
export YAKL_TEST_PNETCDF=OFF
export YAKL_HAVE_MPI=ON
export YAKL_MPI_COMMAND=""
