#!/bin/bash

source ${MODULESHOME}/init/bash
module reset
module load PrgEnv-gnu cray-parallel-netcdf cmake cray-hdf5 cray-netcdf

export CRAYPE_LINK_TYPE=dynamic
export OMP_NUM_THREADS=64
export CC=cc
export CXX=CC
export FC=ftn

unset CXXFLAGS
unset CFLAGS
unset FFLAGS

export YAKL_DEBUG=OFF
export YAKL_CXX_FLAGS="-DHAVE_MPI;-fopenmp;-O3;-Wno-unused-result;-Wno-macro-redefined"
export YAKL_LINK_FLAGS="-fopenmp"
export YAKL_F90_FLAGS="-O3"
export YAKL_BACKEND=Kokkos_ENABLE_OPENMP
export YAKL_ARCH=Kokkos_ARCH_NATIVE
export YAKL_TEST_NETCDF=ON
export YAKL_TEST_PNETCDF=OFF
export YAKL_MPI_COMMAND=""
