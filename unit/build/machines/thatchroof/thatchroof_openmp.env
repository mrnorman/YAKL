#!/bin/bash

export CC=gcc
export CXX=mpic++
export FC=gfortran

unset CXXFLAGS
unset CFLAGS
unset FFLAGS
unset FCFLAGS

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export OMP_MAX_ACTIVE_LEVELS=2
export OMP_PROC_BIND=false
export YAKL_DEBUG=ON
export YAKL_ENABLE_COVERAGE=OFF
export YAKL_UNIT_LARGE_MEMORY=OFF
export YAKL_CXX_FLAGS="-O0;-g;-fopenmp;-Wno-unused-result;-Wno-macro-redefined"
export YAKL_LINK_FLAGS="-g;-fopenmp;-lnetcdf;-lpnetcdf"
export YAKL_F90_FLAGS="-O0;-g"
export YAKL_BACKEND=Kokkos_ENABLE_OPENMP
export YAKL_ARCH=Kokkos_ARCH_NATIVE
export YAKL_TEST_NETCDF=ON
export YAKL_TEST_PNETCDF=ON
export YAKL_HAVE_MPI=OFF
export YAKL_MPI_COMMAND=""
