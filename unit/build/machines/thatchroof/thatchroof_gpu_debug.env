#!/bin/bash

export CC=gcc
export CXX=mpic++
export FC=gfortran

# Kokkos 4.7 predates CUDA 13 API changes, while Kokkos 5.2's C++20 mdspan
# implementation does not compile with NVCC 12.2. The matrix runner selects
# the corresponding toolkit for each version.
export YAKL_KOKKOS_4_7_CUDA_ROOT=/usr/local/cuda-12.2
export YAKL_KOKKOS_5_2_CUDA_ROOT=/usr/local/cuda-13.3
export CUDAToolkit_ROOT="${YAKL_KOKKOS_5_2_CUDA_ROOT}"
export CUDA_ROOT="${CUDAToolkit_ROOT}"
export PATH="${CUDAToolkit_ROOT}/bin:${PATH}"

unset CXXFLAGS
unset CFLAGS
unset FFLAGS
unset FCFLAGS

export YAKL_DEBUG=ON
export YAKL_ENABLE_COVERAGE=ON
export YAKL_UNIT_LARGE_MEMORY=ON
export GATOR_INITIAL_MB=20480
export YAKL_CXX_FLAGS="-O0;-g;-Wno-unused-result;-Wno-macro-redefined"
export YAKL_LINK_FLAGS="-g;-lnetcdf;-lpnetcdf"
export YAKL_F90_FLAGS="-O0;-g"
export YAKL_BACKEND=Kokkos_ENABLE_CUDA
export YAKL_ARCH=Kokkos_ARCH_AMPERE86
export YAKL_TEST_NETCDF=ON
export YAKL_TEST_PNETCDF=ON
export YAKL_MPI_COMMAND=""
