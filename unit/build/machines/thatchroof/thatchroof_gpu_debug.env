#!/bin/bash

export CC=gcc
export CXX=mpic++
export FC=gfortran

unset CXXFLAGS
unset CFLAGS
unset FFLAGS
unset FCFLAGS

export YAKL_DEBUG=ON
export YAKL_ENABLE_COVERAGE=ON
export YAKL_CXX_FLAGS="-O0;-g;-Wno-unused-result;-Wno-macro-redefined"
export YAKL_LINK_FLAGS="-g;-lnetcdf;-lpnetcdf"
export YAKL_F90_FLAGS="-O0;-g"
export YAKL_BACKEND=Kokkos_ENABLE_CUDA
export YAKL_ARCH=Kokkos_ARCH_AMPERE86
export YAKL_TEST_NETCDF=ON
export YAKL_TEST_PNETCDF=ON
export YAKL_MPI_COMMAND=""
